# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project settings -> API -> service_role (server-only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Vapi dashboard -> API Keys -> Public Key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# A secret you choose. Configure the same value as a Bearer Token credential
# in the Vapi dashboard under Integrations -> Server Configuration, and set
# that credential as the Server URL auth for this app's /api/vapi/webhook route.
VAPI_WEBHOOK_SECRET=
